---
import ArticleCard from './ArticleCard.astro';
import type { CollectionEntry } from 'astro:content';
import { getReadingTime } from '../utils/date';
import { getCoverUrl } from '../utils/posts';

interface Props {
  title: string;
  description: string;
  backHref: string;
  backLabel: string;
  posts: CollectionEntry<'posts'>[];
  emptyText: string;
}

const { title, description, backHref, backLabel, posts, emptyText } = Astro.props;
---

<div class="list-page">
  <div class="page-header">
    <a href={backHref} class="back-link">← {backLabel}</a>
    <h1 class="page-title">{title}</h1>
    <p class="page-count">共 {posts.length} 篇文章</p>
  </div>

  <div class="card-grid">
    {posts.map((post) => (
      <ArticleCard
        title={post.data.title}
        summary={post.data.summary}
        date={post.data.date}
        category={post.data.category}
        tags={post.data.tags}
        cover={getCoverUrl(post)}
        slug={post.id}
        pinned={post.data.pinned}
        readingTime={getReadingTime(post.body || '')}
      />
    ))}
  </div>

  {posts.length === 0 && <p class="empty-text">{emptyText}</p>}
</div>

<style>
  .list-page {
    color: var(--text-primary);
  }

  .page-header {
    margin-bottom: 28px;

    .back-link {
      display: inline-block;
      font-size: 13px;
      color: var(--text-tertiary);
      text-decoration: none;
      margin-bottom: 12px;
      transition: color 0.2s ease;

      &:hover {
        color: var(--color-primary);
      }
    }

    .page-title {
      font-size: 1.8em;
      font-weight: 500;
      color: var(--text-primary);
      margin-bottom: 4px;
    }

    .page-count {
      font-size: 14px;
      color: var(--text-tertiary);
    }
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .empty-text {
    color: var(--text-tertiary);
    font-size: 14px;
    padding: 40px 0;
    text-align: center;
  }

  @media (max-width: 1024px) {
    .card-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .card-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
</style>
