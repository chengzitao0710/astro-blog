---
// 主题切换按钮（纯 vanilla JS，无框架依赖）
// 暗色模式逻辑：localStorage 'theme' 优先，其次跟随系统 prefers-color-scheme
---

<button class="theme-toggle" id="theme-toggle" aria-label="切换主题" title="切换主题">
  <!-- 浅色模式显示月亮（点击切到暗色），暗色模式显示太阳（点击切到浅色） -->
  <svg class="icon-moon" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
  </svg>
  <svg class="icon-sun" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="5" />
    <line x1="12" y1="1" x2="12" y2="3" />
    <line x1="12" y1="21" x2="12" y2="23" />
    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
    <line x1="1" y1="12" x2="3" y2="12" />
    <line x1="21" y1="12" x2="23" y2="12" />
    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
  </svg>
</button>

<style>
  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border: none;
    border-radius: 8px;
    background: transparent;
    color: var(--nav-text-color);
    cursor: pointer;
    transition: color 0.22s ease, transform 0.22s ease;

    &:hover {
      color: var(--color-primary);
      transform: translateY(-1px);
    }

    /* 两图标绝对定位叠加，通过 opacity 交叉淡入淡出 */
    position: relative;

    .icon-moon,
    .icon-sun {
      position: absolute;
      transition: opacity 0.25s ease, transform 0.3s ease;
    }

    /* 默认浅色：月亮可见，太阳不可见 */
    .icon-moon { opacity: 1; transform: rotate(0deg) scale(1); }
    .icon-sun  { opacity: 0; transform: rotate(-90deg) scale(0.5); }
  }

  /* 暗色模式：太阳可见，月亮不可见 */
  :global(html[data-theme='dark']) .theme-toggle .icon-moon { opacity: 0; transform: rotate(90deg) scale(0.5); }
  :global(html[data-theme='dark']) .theme-toggle .icon-sun  { opacity: 1; transform: rotate(0deg) scale(1); }
</style>

