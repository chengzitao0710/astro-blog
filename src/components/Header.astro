---
import ThemeToggle from './ThemeToggle.astro';
import { siteConfig } from '../config';

// 当前路径用于高亮导航项
const path = Astro.url.pathname;
const isActive = (p: string) => (p === '/' ? path === '/' : path.startsWith(p));

const navItems = [
  { path: '/', label: '首页' },
  { path: '/articles', label: '文章' },
  { path: '/categories', label: '分类' },
  { path: '/archive', label: '归档' },
  { path: '/about', label: '关于我' },
];
---

<header class="layout-header" id="layout-header">
  <div class="header-pill">
    <a href="/" class="brand">
      <span class="brand-badge">
        {siteConfig.siteLogo ? (
          <img src={siteConfig.siteLogo} class="brand-logo-img" alt="logo" />
        ) : (
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 20h9" /><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z" />
          </svg>
        )}
      </span>
      <span class="brand-name">{siteConfig.siteName}</span>
    </a>

    <nav class="nav">
      {navItems.map((item) => (
        <a href={item.path} class:list={['nav-item', { active: isActive(item.path) }]}>{item.label}</a>
      ))}
    </nav>

    <div class="header-actions">
      <form class="search-form" action="/search" method="get">
        <input
          type="text"
          name="q"
          class="search-input"
          placeholder="搜索文章..."
          aria-label="搜索文章"
        />
      </form>
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .layout-header {
    position: fixed;
    top: 14px;
    left: 0;
    right: 0;
    z-index: 20;
    display: flex;
    justify-content: center;
    padding: 0 16px;
    transition: transform 0.36s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s ease;
    will-change: transform;
  }

  /* 向下滚动时收起 */
  .layout-header.header-hidden {
    transform: translateY(-130%);
    opacity: 0;
  }

  .header-pill {
    display: flex;
    align-items: center;
    gap: 20px;
    width: 100%;
    max-width: 840px;
    min-height: 48px;
    padding: 6px 14px 6px 18px;
    background: var(--bg-card);
    border: 1px solid var(--border-primary);
    border-radius: 18px;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.08);
    transition: box-shadow 0.3s ease, border-color 0.3s ease;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    flex-shrink: 0;

    .brand-badge {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 30px;
      height: 30px;
      border-radius: 8px;
      background: var(--color-primary);
      color: var(--accent-contrast);
      font-size: 16px;
      overflow: hidden;

      .brand-logo-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: inherit;
      }
    }

    .brand-name {
      font-size: 18px;
      font-weight: 500;
      color: var(--nav-text-color);
      letter-spacing: 0.01em;
      white-space: nowrap;
    }
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 2px;
    margin-left: auto;

    .nav-item {
      padding: 7px 14px;
      border-radius: var(--radius-pill);
      color: var(--nav-text-color);
      font-size: 15px;
      font-weight: 400;
      letter-spacing: 0.01em;
      text-decoration: none;
      transition: background 0.22s ease, color 0.2s ease;

      &:hover {
        background: color-mix(in srgb, var(--color-primary) 8%, transparent);
      }

      &.active {
        background: color-mix(in srgb, var(--color-primary) 12%, transparent);
        color: var(--color-primary);
        font-weight: 500;
      }
    }
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;

    .search-input {
      width: 180px;
      height: 34px;
      padding: 0 14px;
      border-radius: var(--radius-pill);
      background: var(--bg-tertiary);
      border: 1px solid transparent;
      color: var(--text-primary);
      font-size: 14px;
      font-family: inherit;
      outline: none;
      transition: border-color 0.2s ease;

      &::placeholder {
        color: var(--text-placeholder);
      }

      &:hover,
      &:focus {
        border-color: var(--color-primary);
      }
    }
  }

  @media (max-width: 768px) {
    .header-pill {
      gap: 10px;
      padding: 6px 10px 6px 12px;
    }

    .brand .brand-name {
      display: none;
    }

    .header-actions .search-input {
      width: 110px;
    }
  }
</style>
