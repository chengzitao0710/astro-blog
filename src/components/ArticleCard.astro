---
// 文章卡片组件（垂直布局：顶部封面 + 下方内容）
// 用于 articles / category / tag 列表页的卡片网格
import { siteConfig } from '../config';
import { formatDate } from '../utils/date';

interface Props {
  title: string;
  summary?: string;
  date: Date;
  category: string;
  tags?: string[];
  cover?: string; // 图床外链或本地路径
  slug: string;
  pinned?: boolean;
  readingTime?: number; // 阅读时间（分钟）
}

const {
  title,
  summary = '',
  date,
  category,
  tags = [],
  cover = '',
  slug,
  pinned = false,
  readingTime = 0,
} = Astro.props;

const siteInitial = (siteConfig.siteName || 'B').charAt(0).toUpperCase();
---

<a href={`/posts/${slug}/`} class="article-card">
  <div class:list={['card-cover', { 'img-loading': !!cover }]}>
    {cover ? (
      <>
        <img src={cover} alt={title} loading="lazy" decoding="async" fetchpriority="low" referrerpolicy="no-referrer"
          onload="this.style.opacity='1'"
          onerror="this.style.display='none';this.nextElementSibling.style.display='grid'" />
        <div class="cover-placeholder" style="display:none">
          <span>{siteInitial}</span>
        </div>
      </>
    ) : (
      <div class="cover-placeholder">
        <span>{siteInitial}</span>
      </div>
    )}
    {pinned && <span class="pin-badge">置顶</span>}
  </div>

  <div class="card-body">
    <div class="card-meta">
      <span class="meta-category">{category}</span>
      <span class="meta-dot">·</span>
      <time class="meta-date">{formatDate(date)}</time>
      {readingTime > 0 && (
        <>
          <span class="meta-dot">·</span>
          <span class="meta-reading">{readingTime} 分钟</span>
        </>
      )}
    </div>

    <h3 class="card-title">{title}</h3>

    {summary && <p class="card-summary">{summary}</p>}

    {tags.length > 0 && (
      <div class="card-tags">
        {tags.slice(0, 3).map((t) => (
          <span class="tag-chip">#{t}</span>
        ))}
      </div>
    )}
  </div>
</a>

<style>
  .article-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-medium);
    background: var(--bg-card);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: transform 0.24s ease, border-color 0.24s ease, box-shadow 0.24s ease;

    &:hover {
      transform: translateY(-3px);
      border-color: var(--border-hover);
      box-shadow: var(--shadow-card-hover);

      .card-cover img {
        transform: scale(1.04);
      }

      .card-title {
        color: var(--color-primary);
      }
    }
  }

  /* 封面区 */
  .card-cover {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: var(--bg-tertiary);
    overflow: hidden;

    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      /* 淡入动画由 .img-loading > img 统一管理 */
    }

    .cover-placeholder {
      width: 100%;
      height: 100%;
      display: grid;
      place-items: center;
      background: var(--gradient-primary);

      span {
        font-size: 36px;
        font-weight: 500;
        color: var(--accent-contrast);
        opacity: 0.85;
      }
    }

    .pin-badge {
      position: absolute;
      top: 10px;
      left: 10px;
      padding: 3px 10px;
      border-radius: var(--radius-pill);
      background: linear-gradient(135deg, #f59e0b, #fbbf24);
      color: #fff;
      font-size: 11px;
      font-weight: 500;
      backdrop-filter: blur(4px);
    }
  }

  /* 内容区 */
  .card-body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 18px 20px 20px;
    flex: 1;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: var(--text-tertiary);

    .meta-category {
      padding: 2px 8px;
      border-radius: var(--radius-pill);
      background: var(--bg-tertiary);
      color: var(--text-secondary);
      font-size: 11px;
    }

    .meta-dot {
      color: var(--text-tertiary);
    }

    .meta-reading {
      font-size: 12px;
      color: var(--text-tertiary);
    }
  }

  .card-title {
    font-size: 17px;
    font-weight: 500;
    line-height: 1.4;
    color: var(--text-primary);
    transition: color 0.2s ease;
    /* 2 行截断 */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-summary {
    font-size: 13px;
    line-height: 1.6;
    color: var(--text-secondary);
    /* 2 行截断 */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: auto;
    padding-top: 4px;

    .tag-chip {
      font-size: 12px;
      color: var(--text-tertiary);
    }
  }
</style>
