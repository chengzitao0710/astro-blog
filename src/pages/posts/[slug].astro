<!-- 文章页脚本：data-astro-rerun 确保每次导航都执行，guard 防止重复注册监听器 -->
<script is:inline data-astro-rerun>
(function () {
// ── 全局 cleanup store ──
window.__articleState = window.__articleState || {
  scrollFns: [],
  observers: [],
};

// ── 清理上一次导航的遗留 ──
function cleanupArticle() {
  var state = window.__articleState;
  // 移除所有 scroll 监听器
  state.scrollFns.forEach(function (fn) { window.removeEventListener('scroll', fn); });
  state.scrollFns = [];
  // 断开所有 Observer
  state.observers.forEach(function (obs) { obs.disconnect(); });
  state.observers = [];
  // 清理代码复制按钮残留（避免重复）
  document.querySelectorAll('.code-copy-btn').forEach(function (b) { b.remove(); });
}

// ── 初始化所有文章功能 ──
function initArticlePage() {
  // 如果不是文章页，跳过
  if (!document.querySelector('.article-detail')) return;

  var state = window.__articleState;

  // ---- 阅读进度条 ----
  (function () {
    var bar = document.getElementById('reading-progress');
    if (!bar) return;
    var fn = function () {
      var article = document.querySelector('.article-detail');
      if (!article) return;
      var rect = article.getBoundingClientRect();
      var articleTop = rect.top + window.scrollY;
      var articleHeight = rect.height;
      var viewportHeight = window.innerHeight;
      var scrolled = window.scrollY - articleTop;
      var total = articleHeight - viewportHeight;
      var pct = Math.min(Math.max(scrolled / total, 0), 1) * 100;
      bar.style.width = pct + '%';
    };
    state.scrollFns.push(fn);
    window.addEventListener('scroll', fn, { passive: true });
    fn();
  })();

  // ---- 个性签名：SVG 描边循环绘制动画 ----
  (function () {
    var card = document.querySelector('.signature-card');
    if (!card) return;

    // 重置动画状态
    card.classList.remove('visible');
    var textEl = card.querySelector('.signature-text');
    var underlineEl = card.querySelector('.signature-underline');

    // 获取精确路径长度，设置 CSS 变量驱动 keyframes
    if (textEl) {
      try {
        var textLen = textEl.getTotalLength();
        if (textLen > 0) {
          textEl.style.setProperty('--stroke-len', String(textLen));
        }
      } catch (e) {}
    }
    if (underlineEl) {
      try {
        var ulLen = underlineEl.getTotalLength();
        if (ulLen > 0) {
          underlineEl.style.setProperty('--underline-len', String(ulLen));
        }
      } catch (e) {}
    }

    // 检查是否已在视口
    var rect = card.getBoundingClientRect();
    var inView = rect.top < window.innerHeight && rect.bottom > 0;

    var obs = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          card.classList.add('visible');
        } else {
          // 离开视口停止动画（滚回来时从描边初始状态重新开始）
          card.classList.remove('visible');
        }
      });
    }, { threshold: 0.15 });

    if (inView) {
      card.classList.add('visible');
    }

    obs.observe(card);
    state.observers.push(obs);
  })();

  // ---- 标签错峰渐入 ----
  (function () {
    var chips = document.querySelectorAll('.article-tags .tag-chip');
    if (!chips.length) return;

    var obs = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          var target = entry.target;
          var delay = Number(target.dataset.revealDelay || 0);
          window.setTimeout(function () { target.classList.add('reveal'); }, delay);
          obs.unobserve(target);
        }
      });
    }, { threshold: 0.2 });

    chips.forEach(function (chip, i) {
      chip.dataset.revealDelay = String(60 * i);
      obs.observe(chip);
    });
    state.observers.push(obs);
  })();

  // ---- 返回顶部 + 评论 + 目录浮动按钮（移动端，滚动时出现，停止滚动后收起） ----
  // 注意：float-toc 按钮会被 TOC 抽屉代码 clone-replace，所以每次 scroll 时重新查询
  (function () {
    var btn = document.getElementById('float-top');
    var cmtBtn = document.getElementById('float-comments');
    var group = document.querySelector('.float-btn-group');
    var hideTimer = null;
    var isInteracting = false;
    var IDLE_DELAY = 1000; // 停止滚动 1s 后收起

    function showButtons() {
      var tocBtn = document.getElementById('float-toc');
      if (btn) btn.classList.add('float-visible');
      if (cmtBtn) cmtBtn.classList.add('float-visible');
      if (tocBtn) tocBtn.classList.add('float-visible');
    }

    function hideButtons() {
      var tocBtn = document.getElementById('float-toc');
      if (btn) btn.classList.remove('float-visible');
      if (cmtBtn) cmtBtn.classList.remove('float-visible');
      if (tocBtn) tocBtn.classList.remove('float-visible');
    }

    var fn = function () {
      // 页面顶部：始终隐藏
      if (window.scrollY <= 400) {
        clearTimeout(hideTimer);
        hideButtons();
        return;
      }
      // 滚动中：显示按钮，并重置收起计时器
      showButtons();
      clearTimeout(hideTimer);
      hideTimer = setTimeout(function () {
        if (!isInteracting) hideButtons();
      }, IDLE_DELAY);
    };

    state.scrollFns.push(fn);
    window.addEventListener('scroll', fn, { passive: true });

    // 用户与按钮交互时：保持显示，不收起
    if (group) {
      var startInteract = function () {
        isInteracting = true;
        clearTimeout(hideTimer);
      };
      var endInteract = function () {
        isInteracting = false;
        clearTimeout(hideTimer);
        hideTimer = setTimeout(hideButtons, IDLE_DELAY);
      };
      group.addEventListener('mouseenter', startInteract);
      group.addEventListener('mouseleave', endInteract);
      group.addEventListener('touchstart', startInteract, { passive: true });
      group.addEventListener('touchend', endInteract, { passive: true });
    }

    if (btn) {
      btn.addEventListener('click', function () {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }
  })();

  // ---- TOC：封面图滚出后显示，正文结束后隐藏 ----
  (function () {
    var toc = document.querySelector('#layout-sidebar .toc');
    if (!toc) return;

    var cover = document.querySelector('.article-cover');
    var content = document.querySelector('.article-content');

    if (!content) {
      toc.classList.add('toc-visible');
      return;
    }

    var fn = function () {
      var isVisible = toc.classList.contains('toc-visible');

      // 封面图底部是否已滚出视口顶部（迟滞防闪烁：已显示时阈值更宽松）
      var coverOut = true;
      if (cover) {
        var coverBottom = cover.getBoundingClientRect().bottom;
        coverOut = isVisible ? coverBottom < 140 : coverBottom < 80;
      }
      // 正文底部是否仍在视口内（迟滞防闪烁：已显示时阈值更宽松）
      var contentBottom = content.getBoundingClientRect().bottom;
      var contentVisible = isVisible ? contentBottom > 60 : contentBottom > 120;

      if (coverOut && contentVisible) {
        toc.classList.add('toc-visible');
      } else {
        toc.classList.remove('toc-visible');
      }
    };
    state.scrollFns.push(fn);
    window.addEventListener('scroll', fn, { passive: true });
    fn();
  })();

  // ---- TOC 操作按钮（返回顶部 / 跳转评论） ----
  (function () {
    var backTop = document.getElementById('toc-back-top');
    if (backTop) {
      backTop.addEventListener('click', function () {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }
    var goComments = document.getElementById('toc-go-comments');
    if (goComments) {
      goComments.addEventListener('click', function () {
        var comments = document.getElementById('comments');
        if (comments) {
          comments.scrollIntoView({ behavior: 'smooth' });
        }
      });
    }
    // 移动端浮动评论按钮
    var floatComments = document.getElementById('float-comments');
    if (floatComments) {
      floatComments.addEventListener('click', function () {
        var comments = document.getElementById('comments');
        if (comments) {
          comments.scrollIntoView({ behavior: 'smooth' });
        }
      });
    }
  })();

  // ---- TOC 高亮 + 进度条动画（参照 ragnote.top article-toc） ----
  (function () {
    var tocNav = document.querySelector('.toc-nav');
    if (!tocNav) return;

    // clone 替换链接以移除旧监听器
    Array.from(tocNav.querySelectorAll('.toc-link')).forEach(function (link) {
      var newLink = link.cloneNode(true);
      link.parentNode.replaceChild(newLink, link);
    });

    var links = Array.from(tocNav.querySelectorAll('.toc-link'));
    var bars = Array.from(tocNav.querySelectorAll('.toc-bar'));
    var wrappers = Array.from(tocNav.querySelectorAll('.toc-item-wrapper'));
    var articleEl = document.querySelector('.article-content');

    // 通过 TOC 链接的 data-heading-id 精确匹配标题元素（排除 pagefind-index-meta 隐藏标题）
    var headings = links.map(function (link) {
      var id = link.getAttribute('data-heading-id');
      return id ? document.getElementById(id) : null;
    }).filter(Boolean);

    if (!headings.length) return;

    // 缺失 id 的标题补上
    headings.forEach(function (h) {
      if (!h.id) {
        var slug = (h.textContent || '').toLowerCase().replace(/[^\u4e00-\u9fa5a-z0-9]+/g, '-').replace(/^-|-$/g, '');
        if (slug) h.id = slug;
      }
    });

    // 缓存 section 位置（resize 时重算）
    var sections = [];
    function recalcSections() {
      sections = headings.map(function (h, i) {
        var rect = h.getBoundingClientRect();
        var top = rect.top + window.scrollY;
        var bottom = i < headings.length - 1
          ? headings[i + 1].getBoundingClientRect().top + window.scrollY
          : Infinity;
        return { id: h.id, top: top, bottom: bottom };
      });
    }
    recalcSections();
    var resizeFn = function () { recalcSections(); updateTOC(); };
    state.scrollFns.push(resizeFn);
    window.addEventListener('resize', resizeFn, { passive: true });

    var isProgrammaticScroll = false;
    var scrollEndTimer;

    function updateTOC() {
      if (isProgrammaticScroll) return;

      var scrollPos = window.scrollY + 120;
      var articleBottom = articleEl
        ? articleEl.getBoundingClientRect().top + window.scrollY + articleEl.offsetHeight
        : Infinity;

      var firstHighlight = -1;
      var lastHighlight = -1;

      sections.forEach(function (sec, i) {
        var bar = bars[i];
        var link = links[i];
        if (!bar || !link) return;

        var progress = 0;
        if (scrollPos >= sec.bottom) {
          progress = 1;
        } else if (scrollPos >= sec.top) {
          var range = sec.bottom === Infinity ? articleBottom - sec.top : sec.bottom - sec.top;
          progress = range > 0 ? Math.min((scrollPos - sec.top) / range, 1) : 0;
        }

        bar.style.height = (progress * 70) + '%';

        if (progress > 0) {
          bar.classList.add('toc-bar-filled');
          link.classList.add('toc-highlight', 'toc-bg-translucent');
          if (firstHighlight === -1) firstHighlight = i;
          lastHighlight = i;
        } else {
          bar.classList.remove('toc-bar-filled');
          link.classList.remove('toc-highlight', 'toc-bg-translucent');
        }
      });

      // 圆角：首项上圆角 / 末项下圆角 / 唯一项全圆角
      links.forEach(function (link, i) {
        link.classList.remove('toc-rounded-top', 'toc-rounded-bottom', 'toc-rounded-single');
        if (firstHighlight === -1) return;
        if (firstHighlight === lastHighlight && i === firstHighlight) {
          link.classList.add('toc-rounded-single');
        } else if (i === firstHighlight) {
          link.classList.add('toc-rounded-top');
        } else if (i === lastHighlight) {
          link.classList.add('toc-rounded-bottom');
        }
      });

      // 自动滚动 TOC 到当前高亮项
      if (lastHighlight >= 0) {
        var activeWrapper = wrappers[lastHighlight];
        if (activeWrapper) {
          var navRect = tocNav.getBoundingClientRect();
          var activeRect = activeWrapper.getBoundingClientRect();
          if (activeRect.top < navRect.top || activeRect.bottom > navRect.bottom) {
            var relativeTop = activeRect.top - navRect.top + tocNav.scrollTop;
            tocNav.scrollTo({
              top: relativeTop - tocNav.clientHeight / 2 + activeWrapper.clientHeight / 2,
              behavior: 'smooth',
            });
          }
        }
      }
    }

    // 点击 TOC 项平滑滚动
    links.forEach(function (link) {
      link.addEventListener('click', function (e) {
        var id = link.getAttribute('href');
        if (!id) return;
        id = id.slice(1);
        var target = document.getElementById(id);
        if (!target) return;
        e.preventDefault();

        var posDelta = Math.abs(target.getBoundingClientRect().top);
        var offset = posDelta > 50 ? 24 : 80;
        isProgrammaticScroll = true;

        window.scrollTo({
          top: window.scrollY + target.getBoundingClientRect().top - offset,
          behavior: 'smooth',
        });

        clearTimeout(scrollEndTimer);
        var reset = function () { isProgrammaticScroll = false; updateTOC(); };
        window.addEventListener('scrollend', reset, { once: true });
        scrollEndTimer = window.setTimeout(reset, 900);
      });
    });

    var fn = function () { updateTOC(); };
    state.scrollFns.push(fn);
    window.addEventListener('scroll', fn, { passive: true });
    updateTOC();
  })();

  // ---- 代码块复制 + 语言标签 ----
  (function () {
    var blocks = document.querySelectorAll('.markdown-body pre');
    var noHover = window.matchMedia('(hover: none)').matches;
    blocks.forEach(function (pre) {
      var btn = document.createElement('button');
      btn.className = 'code-copy-btn';
      btn.setAttribute('aria-label', '复制代码');
      btn.innerHTML = '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';
      btn.style.cssText = 'position:absolute;top:8px;right:8px;padding:4px;border:1px solid var(--border-primary);border-radius:6px;background:var(--bg-card);color:var(--text-tertiary);cursor:pointer;opacity:' + (noHover ? '1' : '0') + ';transition:opacity 0.2s ease;display:flex;align-items:center;justify-content:center;';
      pre.style.position = 'relative';
      pre.appendChild(btn);

      // 语言标签
      var lang = pre.getAttribute('data-language');
      if (lang && lang !== 'plaintext' && lang !== 'txt') {
        var langMap = { js:'JavaScript', ts:'TypeScript', jsx:'JSX', tsx:'TSX', py:'Python', rs:'Rust', go:'Go', java:'Java', c:'C', cpp:'C++', cs:'C#', rb:'Ruby', php:'PHP', swift:'Swift', kt:'Kotlin', scala:'Scala', sh:'Shell', bash:'Bash', zsh:'Zsh', yaml:'YAML', yml:'YAML', json:'JSON', xml:'XML', html:'HTML', css:'CSS', scss:'SCSS', less:'Less', sql:'SQL', graphql:'GraphQL', md:'Markdown', dockerfile:'Dockerfile', diff:'Diff' };
        pre.setAttribute('data-lang', langMap[lang] || lang.toUpperCase());
      }

      pre.addEventListener('mouseenter', function () { btn.style.opacity = '1'; });
      pre.addEventListener('mouseleave', function () { btn.style.opacity = '0'; });
      btn.addEventListener('click', function () {
        var codeText = (pre.querySelector('code') || {}).textContent || '';
        try {
          navigator.clipboard.writeText(codeText).then(function () {
            btn.style.color = 'var(--color-primary)';
            setTimeout(function () { btn.style.color = ''; }, 1500);
          });
        } catch (e) {}
      });
    });
  })();

  // ---- 表格包裹 + 横向滚动提示 ----
  (function () {
    var tables = document.querySelectorAll('.markdown-body table');
    if (!tables.length) return;

    var wrappers = [];

    tables.forEach(function (table) {
      // 跳过已被包裹的表格
      if (table.parentElement && table.parentElement.classList.contains('table-scroll')) return;

      var wrapper = document.createElement('div');
      wrapper.className = 'table-scroll';
      table.parentNode.insertBefore(wrapper, table);
      wrapper.appendChild(table);
      wrappers.push(wrapper);
    });

    if (!wrappers.length) return;

    function updateScrollHint() {
      wrappers.forEach(function (wrapper) {
        var canScroll = wrapper.scrollWidth > wrapper.clientWidth + 2;
        wrapper.classList.toggle('can-scroll', canScroll);

        if (canScroll) {
          var atStart = wrapper.scrollLeft <= 2;
          var atEnd = wrapper.scrollLeft + wrapper.clientWidth >= wrapper.scrollWidth - 2;
          wrapper.classList.toggle('scrolled-start', !atStart);
          wrapper.classList.toggle('scrolled-end', atEnd);
        } else {
          wrapper.classList.remove('scrolled-start', 'scrolled-end');
        }
      });
    }

    // 监听滚动
    wrappers.forEach(function (wrapper) {
      wrapper.addEventListener('scroll', updateScrollHint, { passive: true });
    });

    // 监听窗口大小变化
    var resizeFn = updateScrollHint;
    state.scrollFns.push(resizeFn);
    window.addEventListener('resize', resizeFn, { passive: true });

    updateScrollHint();
  })();

  // ---- 社交分享按钮 ----
  (function () {
    var shareBtns = document.querySelectorAll('.share-chip');
    if (!shareBtns.length) return;
    var pageUrl = window.location.href;
    var pageTitle = document.title;

    shareBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var type = btn.getAttribute('data-share');
        if (type === 'copy') {
          try {
            navigator.clipboard.writeText(pageUrl).then(function () {
              btn.classList.add('copied');
              var origHTML = btn.innerHTML;
              btn.innerHTML = '<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> 已复制';
              setTimeout(function () {
                btn.classList.remove('copied');
                btn.innerHTML = origHTML;
              }, 1800);
            });
          } catch (e) {}
        } else if (type === 'weibo') {
          window.open('https://service.weibo.com/share/share.php?url=' + encodeURIComponent(pageUrl) + '&title=' + encodeURIComponent(pageTitle), '_blank', 'width=600,height=500');
        } else if (type === 'twitter') {
          window.open('https://twitter.com/intent/tweet?url=' + encodeURIComponent(pageUrl) + '&text=' + encodeURIComponent(pageTitle), '_blank', 'width=600,height=500');
        }
      });
    });
  })();

  // ---- 移动端 TOC 抽屉 ----
  (function () {
    var tocBtn = document.getElementById('float-toc');
    var tocOverlay = document.getElementById('toc-overlay');
    var tocClose = document.getElementById('toc-close');
    if (!tocBtn || !tocOverlay || !tocClose) return;

    var newTocBtn = tocBtn.cloneNode(true);
    tocBtn.parentNode.replaceChild(newTocBtn, tocBtn);

    // 获取抽屉内所有可聚焦元素
    function getFocusable() {
      return tocOverlay.querySelectorAll('a[href], button:not([disabled])');
    }

    var closeToc = function () {
      tocOverlay.classList.remove('open');
      tocOverlay.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      // 关闭后焦点返回触发按钮
      newTocBtn.focus();
    };

    newTocBtn.addEventListener('click', function () {
      tocOverlay.classList.add('open');
      tocOverlay.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      // 打开后焦点移到关闭按钮
      tocClose.focus();
    });

    tocClose.addEventListener('click', closeToc);
    tocOverlay.addEventListener('click', function (e) {
      if (e.target === tocOverlay) closeToc();
    });
    tocOverlay.querySelectorAll('a').forEach(function (link) {
      link.addEventListener('click', closeToc);
    });

    // Focus trap：Tab / Shift+Tab 在抽屉内循环
    tocOverlay.addEventListener('keydown', function (e) {
      if (e.key !== 'Tab') return;
      if (tocOverlay.getAttribute('aria-hidden') === 'true') return;
      var focusable = getFocusable();
      if (focusable.length === 0) return;
      var first = focusable[0];
      var last = focusable[focusable.length - 1];
      if (e.shiftKey) {
        if (document.activeElement === first) {
          e.preventDefault();
          last.focus();
        }
      } else {
        if (document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    });
  })();
}

// ── 注册 astro:page-load 监听器只执行一次 ──
if (!window.__articleSetup) {
  window.__articleSetup = true;
  document.addEventListener('astro:page-load', function () {
    cleanupArticle();
    initArticlePage();
  });
}

// 每次脚本执行时直接尝试初始化（覆盖 astro:page-load 已触发的竞态）
cleanupArticle();
initArticlePage();
})();
</script>
