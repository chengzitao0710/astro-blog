---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Giscus from '../../components/Giscus.astro';
import { siteConfig } from '../../config';
import { formatDate, getReadingTime, getWordCount } from '../../utils/date';
import { getPostsByDate, getCoverUrl, getRelatedPosts } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

type Props = { post: CollectionEntry<'posts'> };

const { post } = Astro.props;
const { Content, headings } = await render(post);

// 过滤 h1-h4 作为 TOC（文章用 # 做章节标题，需纳入目录）
const toc = headings.filter((h) => h.depth >= 1 && h.depth <= 4);

// 上下篇：按日期排序
const allPosts = await getPostsByDate();
const currentIndex = allPosts.findIndex((p) => p.id === post.id);
// older = 下一篇（日期更早），newer = 上一篇（日期更晚）
const older = currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : null;
const newer = currentIndex > 0 ? allPosts[currentIndex - 1] : null;

// 相关文章：基于分类和标签匹配度
const relatedPosts = await getRelatedPosts(post, 3);

const cover = getCoverUrl(post);
const readingTime = getReadingTime(post.body || '');
const wordCount = getWordCount(post.body || '');

// JSON-LD 结构化数据
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.summary,
  datePublished: post.data.date.toISOString(),
  dateModified: (post.data.updated || post.data.date).toISOString(),
  author: {
    '@type': 'Person',
    name: siteConfig.siteAuthor,
  },
  publisher: {
    '@type': 'Person',
    name: siteConfig.siteAuthor,
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': new URL(`/posts/${post.id}/`, Astro.site).href,
  },
  ...(cover ? { image: cover } : {}),
  keywords: [post.data.category, ...post.data.tags].join(', '),
};
---

<BaseLayout title={post.data.title} description={post.data.summary} image={cover || ''} hideSidebar={toc.length === 0} jsonLd={jsonLd}>
  <!-- 阅读进度条 -->
  <div class="reading-progress" id="reading-progress" aria-hidden="true"></div>

  <article class="article-detail">
    <!-- 面包屑导航 -->
    <nav class="breadcrumb" aria-label="面包屑导航">
      <a href="/">首页</a>
      <span class="breadcrumb-sep">/</span>
      <a href="/articles">文章</a>
      <span class="breadcrumb-sep">/</span>
      <a href={`/category/${encodeURIComponent(post.data.category)}/`}>{post.data.category}</a>
    </nav>

    <!-- 文章头部 -->
    <header class="article-header">
      <div class="article-meta">
        {post.data.pinned && <span class="pin-badge">置顶</span>}
        <a href={`/category/${encodeURIComponent(post.data.category)}/`} class="category-tag">{post.data.category}</a>
        <span class="meta-dot">·</span>
        <time class="publish-date">{formatDate(post.data.date)}</time>
        {post.data.updated && (
          <>
            <span class="meta-dot">·</span>
            <span class="updated-date">更新于 {formatDate(post.data.updated)}</span>
          </>
        )}
        <span class="meta-dot">·</span>
        <span class="reading-time">约 {readingTime} 分钟</span>
        <span class="meta-dot">·</span>
        <span class="word-count">{wordCount.toLocaleString()} 字</span>
      </div>
      <h1 class="article-title">{post.data.title}</h1>
      {post.data.summary && <p class="article-summary">{post.data.summary}</p>}
    </header>

    <!-- 封面图 -->
    {cover && (
      <div class="article-cover img-loading">
        <img src={cover} alt={post.data.title} loading="eager" decoding="async" fetchpriority="high"
          width="1200" height="525" referrerpolicy="no-referrer"
          onload="this.style.opacity='1'"
          onerror="this.parentElement.style.display='none'" />
      </div>
    )}

    <!-- 正文 -->
    <div class="article-content markdown-body" id="article-body" data-pagefind-body>
      <Content />
      <!-- Pagefind 索引补充：标题、摘要、分类、标签（隐藏，仅供搜索索引） -->
      <div class="pagefind-index-meta" aria-hidden="true" hidden>
        <h1>{post.data.title}</h1>
        {post.data.summary && <p>{post.data.summary}</p>}
        <p>分类：{post.data.category}</p>
        <p>标签：{post.data.tags.join(' ')}</p>
      </div>
    </div>

    <!-- 标签 + 分享按钮 + 评论按钮 -->
    <div class="article-tags">
      {post.data.tags.map((tag) => (
        <a href={`/tag/${encodeURIComponent(tag)}/`} class="tag-chip">#{tag}</a>
      ))}
      <div class="action-chips">
        <!-- 社交分享按钮 -->
        <button class="tag-chip share-chip" data-share="copy" aria-label="复制链接">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
          复制链接
        </button>
        <button class="tag-chip share-chip" data-share="weibo" aria-label="分享到微博">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor"><path d="M10.7 13.5c-3.2.3-5.6 2.1-5.4 4 .2 1.9 3 3.1 6.2 2.8 3.2-.3 5.6-2.1 5.4-4-.2-1.9-3-3.1-6.2-2.8zm.8 5.4c-1.6.2-3-.4-3.1-1.3-.1-.9 1.1-1.7 2.7-1.9 1.6-.2 3 .4 3.1 1.3.1.9-1.1 1.7-2.7 1.9zm-1.7-1.6c-.3 0-.5-.3-.5-.6 0-.3.3-.6.5-.6.3 0 .5.3.5.6 0 .3-.2.6-.5.6zM19.7 8.3c-.3-1-.9-1.7-1.7-2 .3-.8.2-1.6-.1-2.2-.6-1.2-2.2-1.6-4-1.1-.4.1-.6.5-.5.9.1.4.5.6.9.5 1.1-.3 2.1-.1 2.4.5.2.3.1.8-.1 1.2-.2.3-.1.7.2.9.6.4 1.1.9 1.2 1.6.2 1.1-.5 2.3-1.8 3-.3.2-.4.6-.2.9.1.2.3.3.6.3.1 0 .2 0 .3-.1 1.9-1 3-2.9 2.6-4.7-.1-.1-.1-.2-.1-.3z"/></svg>
          微博
        </button>
        <button class="tag-chip share-chip" data-share="twitter" aria-label="分享到 Twitter">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          Twitter
        </button>
      </div>
    </div>

    <!-- 个性签名（参照 ragnote.top endcard-signature 实现：SVG path stroke-dasharray 描边绘制动画） -->
    <div class="signature-card" id="signature-card">
      <div class="signature-deco signature-deco-tl"></div>
      <div class="signature-deco signature-deco-br"></div>
      <div class="signature-wrapper">
        <svg class="signature-svg" viewBox="0 0 280 80" preserveAspectRatio="xMidYMid meet" aria-label={siteConfig.siteAuthor}>
          <text class="signature-text" x="140" y="42" text-anchor="middle"
                font-family="'Caveat', cursive" font-size="46" font-weight="400"
                fill="currentColor" stroke="currentColor" stroke-width="0.5"
                transform="rotate(-2 140 42)">{siteConfig.siteAuthor}</text>
          <path class="signature-underline"
                d="M 32 62 C 62 56, 92 65, 122 58 C 152 52, 182 64, 212 56 C 232 51, 246 55, 252 52"
                fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
        </svg>
      </div>
    </div>

    <!-- 相关文章推荐 -->
    {relatedPosts.length > 0 && (
      <section class="related-posts">
        <h3 class="related-title">相关文章</h3>
        <div class="related-grid">
          {relatedPosts.map((rp) => (
            <a href={`/posts/${rp.id}/`} class="related-card">
              <span class="related-category">{rp.data.category}</span>
              <span class="related-name">{rp.data.title}</span>
              <span class="related-date">{formatDate(rp.data.date)}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- 上下篇导航 -->
    {(newer || older) && (
      <nav class="prev-next">
        {newer ? (
          <a href={`/posts/${newer.id}/`} class="nav-card nav-prev">
            <span class="nav-label">上一篇</span>
            <span class="nav-title">{newer.data.title}</span>
          </a>
        ) : <span class="nav-card nav-placeholder"></span>}
        {older ? (
          <a href={`/posts/${older.id}/`} class="nav-card nav-next">
            <span class="nav-label">下一篇</span>
            <span class="nav-title">{older.data.title}</span>
          </a>
        ) : <span class="nav-card nav-placeholder"></span>}
      </nav>
    )}

    <!-- 评论 -->
    <section class="comments-section" id="comments">
      <Giscus />
    </section>
  </article>

  <!-- 移动端浮动按钮（桌面端按钮已融入 TOC 侧边栏） -->
  <div class="float-btn-group">
    <button class="float-btn float-top" id="float-top" aria-label="返回顶部">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="19" x2="12" y2="5"/><polyline points="5 12 12 5 19 12"/></svg>
    </button>
    <button class="float-btn float-comments" id="float-comments" aria-label="跳转评论区">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
    </button>
    {toc.length > 0 && (
      <>
        <button class="float-btn float-toc" id="float-toc" aria-label="目录">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
        </button>
        <!-- 移动端 TOC 抽屉 -->
        <div class="toc-overlay" id="toc-overlay" aria-hidden="true">
          <div class="toc-drawer" id="toc-drawer">
            <div class="toc-drawer-header">
              <span class="toc-drawer-title">目录</span>
              <button class="toc-drawer-close" id="toc-close" aria-label="关闭目录">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
              </button>
            </div>
            <nav class="toc-drawer-nav">
              {toc.map((item) => (
                <a
                  href={`#${item.slug}`}
                  class:list={['toc-drawer-link', `toc-m-h${item.depth}`]}
                >
                  {item.text}
                </a>
              ))}
            </nav>
          </div>
        </div>
      </>
    )}
  </div>

  {toc.length > 0 && (
    <Fragment slot="sidebar">
      <div class="toc" id="toc-sidebar">
        <h4 class="toc-title">目录</h4>
        <nav class="toc-nav">
          {toc.map((item) => (
            <div class="toc-item-wrapper" data-toc-wrapper={item.slug}>
              <span class="toc-bar" data-toc-bar={item.slug}></span>
              <a
                href={`#${item.slug}`}
                class:list={['toc-link', `toc-h${item.depth}`]}
                data-heading-id={item.slug}
              >
                {item.text}
              </a>
            </div>
          ))}
        </nav>
        <div class="toc-actions">
          <button class="toc-action-btn" id="toc-back-top" aria-label="返回顶部">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="19" x2="12" y2="5"/><polyline points="5 12 12 5 19 12"/></svg>
            <span>顶部</span>
          </button>
          <button class="toc-action-btn" id="toc-go-comments" aria-label="跳转评论区">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            <span>评论</span>
          </button>
        </div>
      </div>
    </Fragment>
  )}
</BaseLayout>

<style>
  /* 阅读进度条 */
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    height: 2.5px;
    width: 0%;
    background: var(--color-primary);
    z-index: 30;
    transition: width 0.1s linear;
    border-radius: 0 2px 2px 0;
  }

  .article-detail {
    color: var(--text-primary);
  }

  /* 文章元素居中约束在 content-max-width */
  .article-detail > *:not(.reading-progress) {
    max-width: var(--content-max-width);
    margin-left: auto;
    margin-right: auto;
  }

  .article-header {
    margin-bottom: 24px;

    .article-meta {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
      color: var(--text-tertiary);
      margin-bottom: 12px;

      .pin-badge {
        padding: 2px 8px;
        border-radius: var(--radius-pill);
        background: linear-gradient(135deg, #f59e0b, #fbbf24);
        color: #fff;
        font-size: 11px;
        font-weight: 500;
      }

      .category-tag {
        padding: 3px 10px;
        border-radius: var(--radius-pill);
        background: var(--color-primary);
        color: var(--accent-contrast);
        font-size: 12px;
        text-decoration: none;
        transition: opacity 0.2s ease;

        &:hover {
          opacity: 0.85;
        }
      }

      .meta-dot {
        color: var(--text-tertiary);
      }

      .reading-time {
        font-size: 13px;
        color: var(--text-tertiary);
      }
    }

    .article-title {
      font-size: 2em;
      font-weight: 600;
      line-height: 1.3;
      color: var(--text-primary);
      margin-bottom: 12px;
    }

    .article-summary {
      font-size: 15px;
      color: var(--text-secondary);
      line-height: 1.7;
    }
  }

  .article-cover {
    width: 100%;
    aspect-ratio: 16 / 7;
    margin-bottom: 28px;
    border-radius: var(--radius-medium);
    overflow: hidden;
    background: var(--bg-tertiary);

    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      /* 淡入动画由 .img-loading > img 统一管理 */
    }
  }

  .article-content {
    min-width: 0;
  }

  /* TOC 在 BaseLayout sidebar 中，sticky 跟随滚动 */
  .toc {
    position: sticky;
    top: 100px;
    align-self: flex-start;
    max-height: calc(100vh - 120px);
    display: flex;
    flex-direction: column;
    background: var(--bg-card);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-medium);
    padding: 24px;
    opacity: 0;
    transform: translateY(20px);
    pointer-events: none;
    transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: opacity, transform;

    &.toc-visible {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }

    .toc-title {
      font-size: 16px;
      font-weight: 600;
      color: var(--text-primary);
      margin-bottom: 16px;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--border-primary);
      flex-shrink: 0;
    }

    .toc-nav {
      display: flex;
      flex-direction: column;
      gap: 4px;
      overflow-y: auto;
      flex: 1;
      min-height: 0;
      padding-right: 4px;
      scroll-behavior: smooth;

      /* 自定义滚动条 */
      &::-webkit-scrollbar {
        width: 4px;
      }
      &::-webkit-scrollbar-track {
        background: transparent;
      }
      &::-webkit-scrollbar-thumb {
        background: var(--border-primary);
        border-radius: 2px;
      }
      &::-webkit-scrollbar-thumb:hover {
        background: var(--text-muted);
      }
      scrollbar-width: thin;
      scrollbar-color: var(--border-primary) transparent;
    }

    .toc-item-wrapper {
      position: relative;
      display: flow-root;
    }

    /* 进度条：每个 TOC 项左侧 2px 宽的垂直条，高度随阅读进度填充 */
    .toc-bar {
      position: absolute;
      left: 0;
      top: 15%;
      width: 2px;
      height: 0%;
      border-radius: 4px;
      background: transparent;
      transition: background-color 0.3s ease, height 0.1s linear;
      pointer-events: none;
      z-index: 1;
    }

    .toc-bar.toc-bar-filled {
      background: var(--color-primary);
    }

    .toc-link {
      display: block;
      position: relative;
      padding: 6px 12px;
      font-size: 14px;
      color: var(--text-tertiary);
      text-decoration: none;
      border-radius: var(--radius-sm);
      transition: color 0.2s ease, background 0.2s ease;
      line-height: 1.5;

      &:hover {
        color: var(--color-primary);
        background: color-mix(in srgb, var(--color-primary) 6%, transparent);
      }

      &.toc-h1 {
        font-weight: 600;
        color: var(--text-secondary);
        font-size: 15px;
        padding-left: 16px;
      }

      &.toc-h2 {
        padding-left: 24px;
        font-size: 14px;
      }

      &.toc-h3 {
        padding-left: 32px;
        font-size: 13px;
        color: var(--text-muted);
      }

      &.toc-h4 {
        padding-left: 40px;
        font-size: 13px;
        color: var(--text-muted);
      }

      /* 高亮：已读 + 正在读的项 */
      &.toc-highlight {
        color: var(--color-primary);
        font-weight: 500;

        &.toc-h1 { font-weight: 600; }
        &.toc-h3, &.toc-h4 { color: color-mix(in srgb, var(--color-primary) 75%, var(--text-muted)); }
      }

      /* 半透明背景：高亮项的背景色 */
      &.toc-bg-translucent {
        background: color-mix(in srgb, var(--color-primary) 9%, transparent);
      }

      /* 连续高亮项的圆角：首项上圆角，末项下圆角 */
      &.toc-rounded-top {
        border-radius: var(--radius-sm) var(--radius-sm) 0 0;
      }

      &.toc-rounded-bottom {
        border-radius: 0 0 var(--radius-sm) var(--radius-sm);
      }

      /* 唯一高亮项：四角圆角 */
      &.toc-rounded-single {
        border-radius: var(--radius-sm);
      }
    }

    .toc-actions {
      display: flex;
      gap: 8px;
      margin-top: 14px;
      padding-top: 14px;
      border-top: 1px solid var(--border-primary);
      flex-shrink: 0;
    }

    .toc-action-btn {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding: 9px 12px;
      border: 1px solid var(--border-primary);
      border-radius: var(--radius-sm);
      background: var(--bg-secondary);
      color: var(--text-secondary);
      cursor: pointer;
      font-size: 13px;
      font-family: inherit;
      transition: var(--transition);

      &:hover {
        color: var(--color-primary);
        border-color: var(--color-primary);
        background: color-mix(in srgb, var(--color-primary) 4%, transparent);
      }
    }
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 32px;
    padding-top: 20px;
    border-top: 1px solid var(--border-secondary);

    .tag-chip {
      padding: 4px 12px;
      border-radius: var(--radius-pill);
      border: 1px solid var(--border-primary);
      font-size: 13px;
      color: var(--text-secondary);
      text-decoration: none;
      transition: all 0.22s ease;
      /* 进入视口前隐藏，等渐入动画触发 */
      opacity: 0;
      transform: translateY(8px);

      &:hover {
        border-color: var(--color-primary);
        background: var(--color-primary);
        color: var(--accent-contrast);
        transform: translateY(-2px);
        box-shadow: 0 4px 12px color-mix(in srgb, var(--color-primary) 22%, transparent);
      }

      /* 触发渐入后显示 */
      &.reveal {
        opacity: 1;
        transform: translateY(0);
      }
    }
  }

  /* 个性签名卡片（参照 ragnote.top endcard-signature：SVG 描边绘制动画） */
  .signature-card {
    margin-top: 48px;
    padding: 36px 28px;
    background: var(--bg-card);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-medium);
    position: relative;
    overflow: hidden;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;

    &:hover {
      border-color: var(--border-hover);
      box-shadow: var(--shadow-card);
    }
  }

  /* 角落装饰线 */
