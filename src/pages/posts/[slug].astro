  /* 循环：0%→50% 描边绘制，50%→100% 停顿展示，下一轮自动回弹重画 */
  @keyframes draw-stroke-loop {
    0%   { stroke-dashoffset: var(--stroke-len); }
    50%  { stroke-dashoffset: 0; }
    100% { stroke-dashoffset: 0; }
  }

  @keyframes draw-underline-loop {
    0%   { stroke-dashoffset: var(--underline-len); }
