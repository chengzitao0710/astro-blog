---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<BaseLayout title="全部文章" description="所有文章列表">
  <div class="list-page">
    <div class="page-header">
      <h1 class="page-title">全部文章</h1>
      <p class="page-count">共 {posts.length} 篇文章</p>
    </div>

    <div class="card-grid">
      {posts.map((post) => (
        <ArticleCard
          title={post.data.title}
          summary={post.data.summary}
          date={post.data.date}
          category={post.data.category}
          tags={post.data.tags}
          cover={typeof post.data.cover === 'string' ? post.data.cover : post.data.cover?.src}
          slug={post.id}
          pinned={post.data.pinned}
        />
      ))}
    </div>

    {posts.length === 0 && <p class="empty-text">暂无文章</p>}
  </div>
</BaseLayout>

<style>
  .list-page {
    color: var(--text-primary);
  }

  .page-header {
    margin-bottom: 28px;

    .page-title {
      font-size: 1.8em;
      font-weight: 500;
      color: var(--text-primary);
      margin-bottom: 4px;
    }

    .page-count {
      font-size: 14px;
      color: var(--text-tertiary);
    }
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 20px;
  }

  .empty-text {
    color: var(--text-tertiary);
    font-size: 14px;
    padding: 40px 0;
    text-align: center;
  }

  @media (max-width: 640px) {
    .card-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
</style>
