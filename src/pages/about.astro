---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config';
import { marked } from 'marked';

// 将 aboutContent 从 Markdown 解析为 HTML
const aboutHtml = siteConfig.aboutContent
  ? await marked.parse(siteConfig.aboutContent)
  : '';

// 平台图标 SVG（使用 currentColor 自适应主题）
const platformIcons: Record<string, string> = {
  github: '<svg viewBox="0 0 16 16" width="22" height="22" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>',
  twitter: '<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>',
  email: '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 5L2 7"/></svg>',
  link: '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>',
};

const getPlatformIcon = (url: string, name: string) => {
  const lower = ((url || '') + ' ' + (name || '')).toLowerCase();
  if (lower.includes('github')) return platformIcons.github;
  if (lower.includes('twitter') || lower.includes('x.com')) return platformIcons.twitter;
  if (lower.includes('mailto:') || lower.includes('email')) return platformIcons.email;
  return platformIcons.link;
};

const isGitHubLink = (url: string) => /github\.com/i.test(url || '');
const getGitHubAvatar = (url: string) => {
  const match = (url || '').match(/github\.com\/([^/?#]+)/i);
  if (!match) return '';
  return `https://avatars.githubusercontent.com/${match[1]}`;
};

const formatUrl = (url: string) => {
  try {
    const u = new URL(url);
    return u.hostname + (u.pathname !== '/' ? u.pathname : '');
  } catch {
    return url;
  }
};

const journey = siteConfig.journey;
const socialLinks = siteConfig.socialLinks;
---

<BaseLayout title="关于我" description={siteConfig.siteDescription} hideSidebar>
  <div class="about-page">
    <!-- Hero 区域 -->
    <div class="about-hero" data-reveal>
      {siteConfig.authorAvatar ? (
        <>
          <div class="hero-avatar-wrap img-loading">
            <img src={siteConfig.authorAvatar} alt={siteConfig.siteAuthor} class="hero-avatar"
              referrerpolicy="no-referrer" decoding="async" fetchpriority="high"
              onload="this.style.opacity='1'"
              onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
            <div class="hero-avatar hero-avatar-fallback" style="display:none">
              <span>{siteConfig.siteAuthor.charAt(0).toUpperCase()}</span>
            </div>
          </div>
        </>
      ) : (
        <div class="hero-avatar hero-avatar-fallback">
          <span>{siteConfig.siteAuthor.charAt(0).toUpperCase()}</span>
        </div>
      )}
      <h1 class="hero-name">{siteConfig.siteAuthor}</h1>
      <p class="hero-tagline">{siteConfig.siteDescription}</p>
    </div>

    <!-- 正文卡片 -->
    <div class="about-card card" data-reveal>
      {aboutHtml && (
        <div class="about-markdown markdown-body" set:html={aboutHtml} />
      )}
    </div>

    <!-- 分隔装饰 -->
    {journey.length > 0 && <div class="section-divider" data-reveal><span class="divider-dot"></span></div>}

    <!-- 旅程时间线 -->
    {journey.length > 0 && (
      <div class="about-section" data-reveal>
        <h2 class="section-title">旅程</h2>
        <div class="journey-timeline">
          {journey.map((item, i) => (
            <div class="journey-item" style={`--delay: ${i * 0.1}s`}>
              <div class="journey-dot"></div>
              <div class="journey-content">
                <span class="journey-date">{item.date}</span>
                <h3 class="journey-title">{item.title}</h3>
                <p class="journey-desc">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- 分隔装饰 -->
    {socialLinks.length > 0 && <div class="section-divider" data-reveal><span class="divider-dot"></span></div>}

    <!-- 联系方式 -->
    {socialLinks.length > 0 && (
      <div class="about-section" data-reveal>
        <h2 class="section-title">联系方式</h2>
        <div class="contact-cards">
          {socialLinks.map((link) => (
            <a href={link.url} target="_blank" rel="noopener noreferrer" class="contact-card">
              {isGitHubLink(link.url) && getGitHubAvatar(link.url) ? (
                <div class="contact-avatar-wrap">
                  <img
                    src={getGitHubAvatar(link.url)}
                    alt={link.name}
                    class="contact-avatar"
                    loading="lazy" decoding="async" fetchpriority="low"
                    referrerpolicy="no-referrer"
                    onerror="this.style.display='none';this.nextElementSibling.style.display='inline-flex'"
                  />
                  <span class="contact-icon contact-icon-fallback" set:html={getPlatformIcon(link.url, link.name)} />
                </div>
              ) : (
                <span class="contact-icon" set:html={getPlatformIcon(link.url, link.name)} />
              )}
              <div class="contact-info">
                <span class="contact-name">{link.name}</span>
                <span class="contact-url">{formatUrl(link.url)}</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}

    <blockquote class="about-quote" data-reveal>
      代码改变世界，学习永无止境。
    </blockquote>
  </div>
</BaseLayout>

<style>
  .about-page {
    color: var(--text-primary);
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* 入场动画 */
  [data-reveal] {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  [data-reveal].revealed {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  /* Hero 区域 */
  .about-hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 20px 0 36px;

    .hero-avatar-wrap {
      width: 96px;
      height: 96px;
      border-radius: 50%;
      margin-bottom: 16px;
    }

    .hero-avatar {
      width: 100%;
      height: 100%;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid var(--border-primary);
      box-shadow: var(--shadow-card);
      display: block;
    }

    .hero-avatar-fallback {
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--color-primary);
      color: var(--accent-contrast);
      font-size: 36px;
      font-weight: 600;
      border: none;
    }

    .hero-name {
      font-size: 30px;
      font-weight: 500;
      color: var(--text-primary);
      margin-bottom: 8px;
    }

    .hero-tagline {
      font-size: 15px;
      color: var(--text-tertiary);
      max-width: 380px;
      line-height: 1.6;
    }
  }

  /* 正文卡片 */
  .about-card {
    margin-bottom: 12px;
  }

  .about-markdown {
    h2 {
      font-size: 1.2em;
      font-weight: 500;
      color: var(--text-primary);
      margin-top: 28px;
      margin-bottom: 12px;
      padding-bottom: 8px;
      border-bottom: 1px solid var(--border-secondary);

      &:first-child {
        margin-top: 0;
      }
    }

    p {
      font-size: 15px;
      line-height: 1.8;
      color: var(--text-secondary);
    }

    ul {
      padding-left: 20px;

      li {
        font-size: 14px;
        line-height: 1.8;
        color: var(--text-secondary);
        margin-bottom: 4px;
      }
    }
  }

  /* 分隔装饰 */
  .section-divider {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 24px 0;

    .divider-dot {
      width: 4px;
      height: 4px;
      border-radius: 50%;
      background: var(--border-hover);
    }
  }

  /* 区块标题 */
  .section-title {
    font-size: 1.3em;
    font-weight: 500;
    color: var(--text-primary);
    margin-bottom: 20px;
  }

  .about-section {
    margin-bottom: 12px;
  }

  /* 旅程时间线 */
  .journey-timeline {
    position: relative;
    padding-left: 28px;

    &::before {
      content: '';
      position: absolute;
      left: 6px;
      top: 8px;
      bottom: 8px;
      width: 2px;
      background: var(--border-primary);
    }
  }

  .journey-item {
    position: relative;
    padding-bottom: 28px;
    opacity: 0;
    transform: translateX(-8px);
    transition: opacity 0.5s ease var(--delay, 0s), transform 0.5s ease var(--delay, 0s);

    &:last-child {
      padding-bottom: 0;
    }
  }

  .about-section.revealed .journey-item {
    opacity: 1;
    transform: translateX(0);
  }

  .journey-dot {
    position: absolute;
    left: -28px;
    top: 4px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--bg-card);
    border: 2px solid var(--color-primary);
    z-index: 1;
    transition: background 0.3s ease;
  }

  .journey-item:hover .journey-dot {
    background: var(--color-primary);
  }

  .journey-content {
    .journey-date {
      display: inline-block;
      font-size: 13px;
      color: var(--text-tertiary);
      margin-bottom: 4px;
    }

    .journey-title {
      font-size: 16px;
      font-weight: 500;
      color: var(--text-primary);
      margin-bottom: 6px;
    }

    .journey-desc {
      font-size: 14px;
      color: var(--text-secondary);
      line-height: 1.7;
    }
  }

  /* 联系方式卡片 */
  .contact-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 14px;
  }

  .contact-card {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 18px;
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-medium);
    background: var(--bg-card);
    text-decoration: none;
    transition: border-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;

    &:hover {
      transform: translateY(-2px);
      border-color: var(--color-primary);
      box-shadow: var(--shadow-card);
    }

    .contact-avatar,
    .contact-icon {
      flex-shrink: 0;
      width: 42px;
      height: 42px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      overflow: hidden;
      color: var(--color-primary);
    }

    .contact-avatar-wrap {
      position: relative;
      width: 42px;
      height: 42px;
      flex-shrink: 0;
    }

    .contact-avatar {
      object-fit: cover;
    }

    .contact-icon-fallback {
      display: none;
    }

    .contact-info {
      display: flex;
      flex-direction: column;
      gap: 2px;
      min-width: 0;

      .contact-name {
        font-size: 14px;
        font-weight: 500;
        color: var(--text-primary);
      }

      .contact-url {
        font-size: 12px;
        color: var(--text-tertiary);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
    }
  }

  /* 引用 */
  .about-quote {
    margin-top: 24px;
    padding: 18px 24px;
    border: 1px solid var(--border-primary);
    border-left: 3px solid var(--color-primary);
    border-radius: var(--radius);
    background: var(--bg-secondary);
    color: var(--text-secondary);
    font-style: italic;
    text-align: center;
    font-size: 15px;
  }
</style>

<!-- 入场动画脚本：astro:page-load 确保 View Transitions 导航后重新执行 -->
<script>
  document.addEventListener('astro:page-load', () => {
    const revealEls = document.querySelectorAll<HTMLElement>('.about-page [data-reveal]');
    revealEls.forEach((el) => {
      // 视口内元素直接显示，避免导航后 IntersectionObserver 延迟导致闪现
      const rect = el.getBoundingClientRect();
      if (rect.top < window.innerHeight && rect.bottom > 0) {
        el.classList.add('revealed');
        return;
      }
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('revealed');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.15 }
      );
      observer.observe(el);
    });
  });
</script>
