---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths({ paginate }: { paginate: Function }) {
  const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime()
  );
  return paginate(posts, { pageSize: 16 });
}

const { page } = Astro.props;

// 生成页码数字列表（含省略号）
const pageNumbers: (number | '…')[] = [];
const last = page.lastPage;
const cur = page.currentPage;
if (last <= 9) {
  for (let i = 1; i <= last; i++) pageNumbers.push(i);
} else {
  pageNumbers.push(1);
  if (cur > 4) pageNumbers.push('…');
  const start = Math.max(2, cur - 2);
  const end = Math.min(last - 1, cur + 2);
  for (let i = start; i <= end; i++) pageNumbers.push(i);
  if (cur < last - 3) pageNumbers.push('…');
  pageNumbers.push(last);
}

const pageHref = (n: number) => (n === 1 ? '/articles' : `/articles/${n}`);
---

<BaseLayout title="全部文章" description="所有文章列表" wideContent>
  <div class="list-page">
    <div class="page-header">
      <h1 class="page-title">全部文章</h1>
      <p class="page-count">共 {page.total} 篇文章</p>
    </div>

    <div class="card-grid">
      {page.data.map((post: any) => (
        <ArticleCard
          title={post.data.title}
          summary={post.data.summary}
          date={post.data.date}
          category={post.data.category}
          tags={post.data.tags}
          cover={typeof post.data.cover === 'string' ? post.data.cover : post.data.cover?.src}
          slug={post.id}
          pinned={post.data.pinned}
        />
      ))}
    </div>

    {page.total === 0 && <p class="empty-text">暂无文章</p>}

    <!-- 分页导航 -->
    {page.lastPage > 1 && (
      <nav class="pagination" aria-label="文章分页">
        <a
          href={page.url.prev}
          class:list={['page-btn', 'page-nav', { disabled: !page.url.prev }]}
          aria-label="上一页"
          aria-disabled={!page.url.prev}
        >
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        </a>

        {pageNumbers.map((n) =>
          n === '…' ? (
            <span class="page-ellipsis">…</span>
          ) : (
            <a
              href={pageHref(n)}
              class:list={['page-btn', 'page-num', { active: n === page.currentPage }]}
              aria-current={n === page.currentPage ? 'page' : undefined}
            >{n}</a>
          )
        )}

        <a
          href={page.url.next}
          class:list={['page-btn', 'page-nav', { disabled: !page.url.next }]}
          aria-label="下一页"
          aria-disabled={!page.url.next}
        >
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        </a>
      </nav>
    )}
  </div>
</BaseLayout>

<style>
  .list-page {
    color: var(--text-primary);
  }

  .page-header {
    margin-bottom: 28px;

    .page-title {
      font-size: 1.8em;
      font-weight: 500;
      color: var(--text-primary);
      margin-bottom: 4px;
    }

    .page-count {
      font-size: 14px;
      color: var(--text-tertiary);
    }
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .empty-text {
    color: var(--text-tertiary);
    font-size: 14px;
    padding: 40px 0;
    text-align: center;
  }

  /* 分页导航 */
  .pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 40px;
    flex-wrap: wrap;
  }

  .page-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 38px;
    height: 38px;
    padding: 0 10px;
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-sm);
    background: var(--bg-card);
    color: var(--text-secondary);
    font-size: 14px;
    text-decoration: none;
    cursor: pointer;
    transition: var(--transition);

    &:hover:not(.disabled):not(.active) {
      border-color: var(--color-primary);
      color: var(--color-primary);
      transform: translateY(-1px);
    }

    &.active {
      background: var(--color-primary);
      border-color: var(--color-primary);
      color: var(--accent-contrast);
      font-weight: 500;
      cursor: default;
    }

    &.disabled {
      opacity: 0.35;
      cursor: not-allowed;
      pointer-events: none;
    }
  }

  .page-nav {
    padding: 0;
    width: 38px;
  }

  .page-ellipsis {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 28px;
    height: 38px;
    color: var(--text-tertiary);
    font-size: 14px;
    user-select: none;
  }

  /* 响应式：平板 2 列，手机 1 列 */
  @media (max-width: 1024px) {
    .card-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .card-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
</style>
