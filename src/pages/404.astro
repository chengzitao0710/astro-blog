---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面不存在" description="404 Not Found" hideSidebar>
  <div class="not-found">
    <div class="nf-code">404</div>
    <p class="nf-text">页面不存在或已移除</p>
    <a href="/" class="nf-back">← 返回首页</a>
  </div>
</BaseLayout>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 80px 20px;
    text-align: center;

    .nf-code {
      font-size: 6em;
      font-weight: 600;
      color: var(--color-primary);
      line-height: 1;
      margin-bottom: 16px;
    }

    .nf-text {
      font-size: 16px;
      color: var(--text-secondary);
      margin-bottom: 24px;
    }

    .nf-back {
      display: inline-block;
      padding: 8px 20px;
      border: 1px solid var(--border-primary);
      border-radius: var(--radius-pill);
      color: var(--text-secondary);
      text-decoration: none;
      font-size: 14px;
      transition: var(--transition);

      &:hover {
        border-color: var(--color-primary);
        color: var(--color-primary);
        transform: translateY(-2px);
      }
    }
  }
</style>
