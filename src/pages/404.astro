---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPostsByDate } from '../utils/posts';

// 获取最新 5 篇文章作为推荐
const posts = (await getPostsByDate()).slice(0, 5);
---

<BaseLayout title="页面不存在" description="404 Not Found" hideSidebar>
  <div class="not-found">
    <div class="nf-code">404</div>
    <p class="nf-text">页面不存在或已移除</p>

    <a href="/" class="nf-back">← 返回首页</a>

    {posts.length > 0 && (
      <div class="nf-suggestions">
        <p class="nf-suggest-label">或浏览最新文章</p>
        <ul class="nf-post-list">
          {posts.map((post) => (
            <li>
              <a href={`/posts/${post.id}/`} class="nf-post-link">
                <span class="nf-post-title">{post.data.title}</span>
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 60px 20px 80px;
    text-align: center;

    .nf-code {
      font-size: 6em;
      font-weight: 600;
      color: var(--color-primary);
      line-height: 1;
      margin-bottom: 16px;
      animation: nf-fade-in 0.5s ease both;
    }

    .nf-text {
      font-size: 16px;
      color: var(--text-secondary);
      margin-bottom: 24px;
      animation: nf-fade-in 0.5s ease 0.1s both;
    }

    .nf-back {
      display: inline-block;
      padding: 8px 20px;
      border: 1px solid var(--border-primary);
      border-radius: var(--radius-pill);
      color: var(--text-secondary);
      text-decoration: none;
      font-size: 14px;
      transition: border-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
      animation: nf-fade-in 0.5s ease 0.2s both;

      &:hover {
        border-color: var(--color-primary);
        color: var(--color-primary);
        transform: translateY(-2px);
      }
    }

    .nf-suggestions {
      margin-top: 48px;
      width: 100%;
      max-width: 480px;
      animation: nf-fade-in 0.5s ease 0.3s both;
    }

    .nf-suggest-label {
      font-size: 13px;
      color: var(--text-tertiary);
      margin-bottom: 12px;
    }

    .nf-post-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 2px;

      li {
        list-style: none;
      }
    }

    .nf-post-link {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      padding: 10px 16px;
      border-radius: var(--radius);
      color: var(--text-secondary);
      text-decoration: none;
      font-size: 14px;
      transition: background 0.2s ease, color 0.2s ease;

      &:hover {
        background: var(--bg-tertiary);
        color: var(--color-primary);

        svg {
          transform: translateX(3px);
        }
      }

      .nf-post-title {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      svg {
        flex-shrink: 0;
        transition: transform 0.2s ease;
      }
    }
  }

  @keyframes nf-fade-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nf-code,
    .nf-text,
    .nf-back,
    .nf-suggestions {
      animation: none;
    }
  }
</style>
