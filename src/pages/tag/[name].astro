---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CollectionList from '../../components/CollectionList.astro';
import { getPostsByDate } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getPostsByDate();
  const tagSet = new Set<string>();
  posts.forEach((p) => p.data.tags.forEach((t) => tagSet.add(t)));
  return [...tagSet].map((tag) => ({
    params: { name: tag },
    props: {
      tag,
      posts: posts.filter((p) => p.data.tags.includes(tag)),
    },
  }));
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`标签：${tag}`} description={`标签「${tag}」下的所有文章`} wideContent>
  <CollectionList
    title={`#${tag}`}
    backHref="/articles"
    backLabel="全部文章"
    posts={posts}
    emptyText="该标签下暂无文章"
  />
</BaseLayout>
