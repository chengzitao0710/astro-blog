---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  const tagSet = new Set<string>();
  posts.forEach((p) => p.data.tags.forEach((t) => tagSet.add(t)));
  return [...tagSet].map((tag) => ({
    params: { name: tag },
    props: {
      tag,
      posts: posts
        .filter((p) => p.data.tags.includes(tag))
        .sort((a, b) => b.data.date.getTime() - a.data.date.getTime()),
    },
  }));
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`标签：${tag}`} description={`标签「${tag}」下的所有文章`}>
  <div class="list-page">
    <div class="page-header">
      <a href="/articles" class="back-link">← 全部文章</a>
      <h1 class="page-title">#{tag}</h1>
      <p class="page-count">共 {posts.length} 篇文章</p>
    </div>

    <div class="card-grid">
      {posts.map((post) => (
        <ArticleCard
          title={post.data.title}
          summary={post.data.summary}
          date={post.data.date}
          category={post.data.category}
          tags={post.data.tags}
          cover={typeof post.data.cover === 'string' ? post.data.cover : post.data.cover?.src}
          slug={post.id}
          pinned={post.data.pinned}
        />
      ))}
    </div>

    {posts.length === 0 && <p class="empty-text">该标签下暂无文章</p>}
  </div>
</BaseLayout>

<style>
  .list-page {
    color: var(--text-primary);
  }

  .page-header {
    margin-bottom: 28px;

    .back-link {
      display: inline-block;
      font-size: 13px;
      color: var(--text-tertiary);
      text-decoration: none;
      margin-bottom: 12px;
      transition: color 0.2s ease;

      &:hover {
        color: var(--color-primary);
      }
    }

    .page-title {
      font-size: 1.8em;
      font-weight: 500;
      color: var(--text-primary);
      margin-bottom: 4px;
    }

    .page-count {
      font-size: 14px;
      color: var(--text-tertiary);
    }
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 20px;
  }

  .empty-text {
    color: var(--text-tertiary);
    font-size: 14px;
    padding: 40px 0;
    text-align: center;
  }

  @media (max-width: 640px) {
    .card-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
</style>
