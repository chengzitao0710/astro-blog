---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPostsByDate } from '../utils/posts';

const posts = await getPostsByDate();

// 按分类聚合
const categoryMap = new Map<string, typeof posts>();
for (const post of posts) {
  const cat = post.data.category;
  if (!categoryMap.has(cat)) categoryMap.set(cat, []);
  categoryMap.get(cat)!.push(post);
}

// 按文章数降序排列
const categories = [...categoryMap.entries()]
  .map(([name, catPosts]) => ({
    name,
    count: catPosts.length,
    latest: catPosts[0], // 最近一篇
  }))
  .sort((a, b) => b.count - a.count);

const totalPosts = posts.length;

// 按标签聚合（用于标签云）
const tagMap = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    tagMap.set(tag, (tagMap.get(tag) || 0) + 1);
  }
}
const tags = [...tagMap.entries()]
  .map(([name, count]) => ({ name, count }))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));

---

<BaseLayout title="分类" description="所有文章分类总览">
  <div class="categories-page">
    <h1 class="page-title">分类</h1>
    <p class="page-count">共 {categories.length} 个分类，{totalPosts} 篇文章</p>

    <div class="category-grid">
      {categories.map((cat) => (
        <a href={`/category/${encodeURIComponent(cat.name)}/`} class="category-card">
          <div class="card-header">
            <h2 class="card-name">{cat.name}</h2>
            <span class="card-count">{cat.count}</span>
          </div>
          {cat.latest && (
            <p class="card-latest">
              <span class="latest-label">最新</span>
              <span class="latest-title">{cat.latest.data.title}</span>
            </p>
          )}
          <div class="card-bar">
            <div
              class="card-bar-fill"
              style={`width: ${Math.round((cat.count / totalPosts) * 100)}%`}
            ></div>
          </div>
        </a>
      ))}
    </div>

    {categories.length === 0 && <p class="empty-text">暂无分类，请先添加文章</p>}

    {/* 标签云 */}
    {tags.length > 0 && (
      <section class="tag-cloud-section">
        <h2 class="tag-cloud-title">标签</h2>
        <div class="tag-cloud">
          {tags.map((tag) => {
            return (
              <a
                href={`/tag/${encodeURIComponent(tag.name)}/`}
                class="cloud-tag"
              >
                {tag.name}
                <span class="cloud-count">{tag.count}</span>
              </a>
            );
          })}
        </div>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .categories-page {
    color: var(--text-primary);
  }

  .page-title {
    font-size: 1.8em;
    font-weight: 500;
    color: var(--text-primary);
    margin-bottom: 4px;
  }

  .page-count {
    font-size: 14px;
    color: var(--text-tertiary);
    margin-bottom: 28px;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
  }

  .category-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 20px;
    background: var(--bg-card);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-medium);
    text-decoration: none;
    transition: border-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;

    &:hover {
      border-color: var(--color-primary);
      transform: translateY(-2px);
      box-shadow: var(--shadow-card);

      .card-name {
        color: var(--color-primary);
      }

      .card-count {
        background: var(--color-primary);
        color: var(--accent-contrast);
      }
    }

    .card-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .card-name {
      font-size: 1.15em;
      font-weight: 500;
      color: var(--text-primary);
      transition: color 0.2s ease;
    }

    .card-count {
      flex-shrink: 0;
      min-width: 28px;
      height: 28px;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0 8px;
      border-radius: var(--radius-pill);
      border: 1px solid var(--border-primary);
      font-size: 13px;
      font-weight: 500;
      color: var(--text-secondary);
      font-variant-numeric: tabular-nums;
      transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
    }

    .card-latest {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
      color: var(--text-tertiary);
      line-height: 1.4;
      min-width: 0;

      .latest-label {
        flex-shrink: 0;
        padding: 1px 6px;
        border-radius: 4px;
        background: var(--bg-tertiary);
        font-size: 11px;
        color: var(--text-muted);
      }

      .latest-title {
        flex: 1;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
    }

    .card-bar {
      height: 3px;
      border-radius: 2px;
      background: var(--border-secondary);
      overflow: hidden;

      .card-bar-fill {
        height: 100%;
        border-radius: 2px;
        background: var(--color-primary);
        transition: width 0.4s ease;
        min-width: 4px;
      }
    }
  }

  .empty-text {
    color: var(--text-tertiary);
    font-size: 14px;
    padding: 40px 0;
    text-align: center;
  }

  /* 标签云 */
  .tag-cloud-section {
    margin-top: 48px;
    padding-top: 32px;
    border-top: 1px solid var(--border-secondary);
  }

  .tag-cloud-title {
    font-size: 1.3em;
    font-weight: 500;
    color: var(--text-primary);
    margin-bottom: 20px;
  }

  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
  }

  .cloud-tag {
    display: inline-flex;
    align-items: baseline;
    gap: 4px;
    padding: 4px 12px;
    border-radius: var(--radius-pill);
    background: var(--bg-card);
    border: 1px solid var(--border-primary);
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.9em;
    line-height: 1.6;
    transition: all 0.2s ease;

    &:hover {
      border-color: var(--color-primary);
      color: var(--color-primary);
      transform: translateY(-2px);
      box-shadow: 0 4px 12px color-mix(in srgb, var(--color-primary) 12%, transparent);
    }

    .cloud-count {
      font-size: 0.7em;
      color: var(--text-muted);
      font-variant-numeric: tabular-nums;
    }
  }

  @media (max-width: 640px) {
    .category-grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }
  }
</style>
